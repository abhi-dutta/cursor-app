{
  "name": "spec-driven-harness-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-driven full-stack demo app for showcasing Harness CI/CD to GKE",
  "scripts": {
    "install:all": "npm --prefix backend ci",
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "validate-spec": "node backend/src/validate-cli.js spec/app.spec.yaml spec/examples/*.spec.yaml",
    "spec:use": "node scripts/use-spec.js",
    "compose:up": "docker compose up --build",
    "k8s:render:dev": "kubectl kustomize k8s/overlays/dev",
    "k8s:render:prod": "kubectl kustomize k8s/overlays/prod"
  }
}
