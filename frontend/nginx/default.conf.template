# Rendered by the nginx image entrypoint (envsubst) at container start.
# BACKEND_URL is e.g. http://backend:3000 (compose service / k8s Service name).

# Per-client request budget for the API (the backend has its own limiter too).
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_status 429;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 16k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 65s;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Kubernetes probe endpoint (does not depend on the backend)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # REST API -> backend
    location /api/ {
        limit_req zone=api burst=60 nodelay;

        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The backend never reads forwarded-IP headers (client identity is the socket peer), and
        # per-client limiting is done here from the real TCP address ($binary_remote_addr).
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_hide_header X-Powered-By;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
    }

    # Static assets. no-cache => browsers revalidate, so a new release shows up immediately.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
